// Schéma de base de données — Gestion des Services Médicaux UCAD
// Provider: SQLite en développement. Pour la production, remplacer par
// provider = "postgresql" et définir DATABASE_URL vers votre instance PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Utilisateurs & authentification
// Rôles (String, validés côté application) :
//   ADMIN | MEDECIN | PHARMACIEN | INFIRMIER | SECRETAIRE
// ─────────────────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  motDePasse   String
  nom          String
  prenom       String
  role         String   @default("SECRETAIRE")
  specialite   String? // pour les médecins (ex: Généraliste, Dentiste)
  telephone    String?
  actif        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Lien vers le dossier patient pour les comptes ETUDIANT (self-service).
  patientId String?  @unique
  patient   Patient? @relation("CompteEtudiant", fields: [patientId], references: [id], onDelete: Cascade)

  rendezVous    RendezVous[]   @relation("MedecinRendezVous")
  consultations Consultation[] @relation("MedecinConsultations")
  orientations  Orientation[]  @relation("MedecinOrientations")
  examensPrescrits DemandeExamen[]  @relation("MedecinExamens")
  resultatsExamen  ResultatExamen[] @relation("LaborantinResultats")
  notifications    Notification[]
}

// ─────────────────────────────────────────────────────────────
// Patients (étudiants & personnels UCAD)
// ─────────────────────────────────────────────────────────────
model Patient {
  id           String    @id @default(cuid())
  matricule    String    @unique // n° étudiant ou matricule personnel
  nom          String
  prenom       String
  dateNaissance DateTime?
  sexe         String? // M | F
  telephone    String?
  email        String?
  adresse      String?
  type         String    @default("ETUDIANT") // ETUDIANT | PERSONNEL | AUTRE
  faculte      String? // Faculté ou service de rattachement
  photoUrl     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  dossier       DossierMedical?
  compte        User?           @relation("CompteEtudiant")
  rendezVous    RendezVous[]
  consultations Consultation[]
  orientations  Orientation[]
  ordonnances   Ordonnance[]
  demandesExamen DemandeExamen[]
}

// ─────────────────────────────────────────────────────────────
// Dossier médical (1–1 avec Patient)
// ─────────────────────────────────────────────────────────────
model DossierMedical {
  id                     String   @id @default(cuid())
  numeroDossier          String   @unique
  patientId              String   @unique
  patient                Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  groupeSanguin          String? // A+, O-, ...
  allergies              String? // texte libre
  antecedentsMedicaux    String?
  antecedentsChirurgicaux String?
  antecedentsFamiliaux   String?
  traitementEnCours      String?
  observations           String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  antecedents  AntecedentMedical[]
  allergieList Allergie[]
  vaccinations Vaccination[]
}

// ─────────────────────────────────────────────────────────────
// Dossier structuré : antécédents, allergies, vaccinations
// ─────────────────────────────────────────────────────────────
model AntecedentMedical {
  id        String         @id @default(cuid())
  dossierId String
  dossier   DossierMedical @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  type      String // MEDICAL | CHIRURGICAL | FAMILIAL | CHRONIQUE
  libelle   String
  annee     String? // année ou période (texte libre)
  notes     String?
  createdAt DateTime       @default(now())

  @@index([dossierId])
}

model Allergie {
  id        String         @id @default(cuid())
  dossierId String
  dossier   DossierMedical @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  substance String
  type      String // MEDICAMENTEUSE | ALIMENTAIRE | AUTRE
  severite  String? // LEGERE | MODEREE | SEVERE
  reaction  String?
  createdAt DateTime       @default(now())

  @@index([dossierId])
}

model Vaccination {
  id        String         @id @default(cuid())
  dossierId String
  dossier   DossierMedical @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  vaccin    String
  dateAdmin DateTime?
  rappel    DateTime? // prochaine dose / rappel
  notes     String?
  createdAt DateTime       @default(now())

  @@index([dossierId])
}

// ─────────────────────────────────────────────────────────────
// Examens de laboratoire / imagerie
// Statut : DEMANDE | EN_COURS | TERMINE | ANNULE
// ─────────────────────────────────────────────────────────────
model DemandeExamen {
  id             String        @id @default(cuid())
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medecinId      String
  medecin        User          @relation("MedecinExamens", fields: [medecinId], references: [id])
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id])
  type           String // libellé (ex: NFS, Glycémie, Radiographie thorax)
  categorie      String        @default("BIOLOGIE") // BIOLOGIE | IMAGERIE | AUTRE
  motif          String?
  priorite       String        @default("NORMALE") // NORMALE | URGENTE
  statut         String        @default("DEMANDE") // DEMANDE | EN_COURS | TERMINE | ANNULE
  date           DateTime      @default(now())
  createdAt      DateTime      @default(now())

  resultat ResultatExamen?

  @@index([patientId])
  @@index([statut])
}

model ResultatExamen {
  id           String        @id @default(cuid())
  demandeId    String        @unique
  demande      DemandeExamen @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  laborantinId String?
  laborantin   User?         @relation("LaborantinResultats", fields: [laborantinId], references: [id])
  valeurs      String?
  conclusion   String?
  documentUrl  String?
  date         DateTime      @default(now())
  createdAt    DateTime      @default(now())
}

// ─────────────────────────────────────────────────────────────
// Notifications destinées aux patients (portail étudiant)
// ─────────────────────────────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titre     String
  message   String?
  lien      String?
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Rendez-vous
// Statut : PLANIFIE | CONFIRME | EN_COURS | TERMINE | ANNULE | ABSENT
// ─────────────────────────────────────────────────────────────
model RendezVous {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medecinId String
  medecin   User     @relation("MedecinRendezVous", fields: [medecinId], references: [id])
  dateHeure DateTime
  duree     Int      @default(30) // minutes
  motif     String?
  statut    String   @default("PLANIFIE")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultation Consultation?

  @@index([dateHeure])
  @@index([medecinId])
}

// ─────────────────────────────────────────────────────────────
// Consultations
// ─────────────────────────────────────────────────────────────
model Consultation {
  id           String      @id @default(cuid())
  patientId    String
  patient      Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medecinId    String
  medecin      User        @relation("MedecinConsultations", fields: [medecinId], references: [id])
  rendezVousId String?     @unique
  rendezVous   RendezVous? @relation(fields: [rendezVousId], references: [id])
  date         DateTime    @default(now())
  motif        String?
  symptomes    String?
  diagnostic   String?
  traitement   String?
  observations String?
  // Constantes / signes vitaux
  poids        Float?
  taille       Float?
  temperature  Float?
  tensionArt   String? // ex: 12/8
  pouls        Int?
  createdAt    DateTime    @default(now())

  ordonnances    Ordonnance[]
  orientations   Orientation[]
  demandesExamen DemandeExamen[]

  @@index([patientId])
}

// ─────────────────────────────────────────────────────────────
// Orientations / redirections vers spécialistes
// Statut : EN_ATTENTE | REALISEE | ANNULEE
// ─────────────────────────────────────────────────────────────
model Orientation {
  id             String        @id @default(cuid())
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medecinId      String
  medecin        User          @relation("MedecinOrientations", fields: [medecinId], references: [id])
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id])
  serviceCible   String // ex: Cardiologie, Hôpital Fann
  motif          String
  statut         String        @default("EN_ATTENTE")
  date           DateTime      @default(now())
  createdAt      DateTime      @default(now())
}

// ─────────────────────────────────────────────────────────────
// Pharmacie — Médicaments (stock)
// ─────────────────────────────────────────────────────────────
model Medicament {
  id            String   @id @default(cuid())
  nom           String
  dci           String? // dénomination commune internationale
  forme         String? // comprimé, sirop, injectable...
  dosage        String?
  stock         Int      @default(0)
  seuilAlerte   Int      @default(10)
  prix          Float    @default(0)
  datePeremption DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lignesOrdonnance LigneOrdonnance[]
}

// ─────────────────────────────────────────────────────────────
// Ordonnances & lignes d'ordonnance
// Statut : EN_ATTENTE | DELIVREE | PARTIELLE | ANNULEE
// ─────────────────────────────────────────────────────────────
model Ordonnance {
  id             String        @id @default(cuid())
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id])
  statut         String        @default("EN_ATTENTE")
  date           DateTime      @default(now())
  createdAt      DateTime      @default(now())

  lignes LigneOrdonnance[]
}

model LigneOrdonnance {
  id           String      @id @default(cuid())
  ordonnanceId String
  ordonnance   Ordonnance  @relation(fields: [ordonnanceId], references: [id], onDelete: Cascade)
  medicamentId String?
  medicament   Medicament? @relation(fields: [medicamentId], references: [id])
  designation  String // libellé du médicament (au cas où hors stock)
  posologie    String?
  duree        String?
  quantite     Int         @default(1)
  delivre      Boolean     @default(false)
}

// ─────────────────────────────────────────────────────────────
// Journal d'audit — traçabilité des accès et des modifications
// ─────────────────────────────────────────────────────────────
model JournalAudit {
  id        String   @id @default(cuid())
  userId    String? // auteur de l'action (null si système)
  userEmail String?
  userRole  String?
  action    String // ex: patient.create, consultation.update, dossier.view
  cible     String? // entité concernée (type#id ou libellé)
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}
